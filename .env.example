# Public base URL for streamed audio assets (Cloudflare R2). Interim is the R2-managed
# r2.dev URL; a custom domain follows once the domain moves to Cloudflare DNS.
# Leave empty to fall back to same-origin "/<key>" (e.g. a local sample under public/).
VITE_AUDIO_BASE_URL=https://pub-<hash>.r2.dev

# Bilingual EN/PT layer. Production enables it via .env.production; set it here to
# preview /pt locally, or leave unset for an English-only dev build.
# VITE_I18N=true
