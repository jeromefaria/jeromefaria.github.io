{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "selector-class-pattern": ["^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]*(-[a-z0-9]+)*)?(--[a-z0-9]*(-[a-z0-9]+)*)?$", { "message": "Expected class selector to follow BEM (block__element--modifier)" }],
    "media-feature-range-notation": "prefix",
    "value-keyword-case": ["lower", { "camelCaseSvgKeywords": true, "ignoreKeywords": ["currentColor", "BlinkMacSystemFont", "Roboto", "Menlo", "Monaco", "Consolas"] }]
  }
}
