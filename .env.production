# Public base URL for streamed audio, baked into the production build.
# Interim R2 managed (r2.dev) URL; swap to a custom domain once jeromefaria.com moves to Cloudflare DNS.
VITE_AUDIO_BASE_URL=https://pub-51db0a7f06d449d787e9daf83e12c8dd.r2.dev

# Ships the bilingual EN/PT layer: /pt routes, the footer language switcher, and
# PT social-card metadata. Unset for an English-only build (the whole i18n path,
# vue-i18n included, is tree-shaken out).
VITE_I18N=true
