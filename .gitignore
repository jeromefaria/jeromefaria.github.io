public/epk/CREDITS*.txt

# CV PDF and social card — regenerated at build from content/resume.md
public/jerome-faria-cv.pdf
public/og-cv.png

# Local, private notes — planning docs kept alongside the code but never published
.notes/

# Full-resolution press-photo masters — kept locally for the downloadable kit, never committed
assets-source/

# Local AAC encode staging — assets live in R2, never committed
audio-dist/
