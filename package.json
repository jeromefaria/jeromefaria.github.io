{
  "name": "jeromefaria-website",
  "version": "1.0.0",
  "description": "Jerome Faria - Sound Artist & Composer",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:i18n": "VITE_I18N=true vite",
    "build:i18n": "VITE_I18N=true npm run build",
    "build": "vue-tsc --noEmit && node scripts/check-anchors.js && node scripts/check-epk-photos.mjs && vite-ssg build && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "lint": "eslint . && stylelint \"src/styles/**/*.scss\" && node scripts/check-custom-properties.mjs && node scripts/check-html-comments.mjs",
    "lint:fix": "eslint . --fix && stylelint \"src/styles/**/*.scss\" --fix",
    "lint:css": "stylelint \"src/styles/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/styles/**/*.scss\" --fix",
    "type-check": "vue-tsc --noEmit",
    "check:anchors": "node scripts/check-anchors.js",
    "check:css-vars": "node scripts/check-custom-properties.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "npm run downloads:build && npm run build && playwright test --grep-invert @visual",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "lighthouse:mobile": "lhci autorun --config=.lighthouserc.mobile.json",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:visual:update": "playwright test --grep @visual --update-snapshots",
    "prebuild": "node scripts/generate-responsive-images.mjs",
    "predev": "node scripts/generate-responsive-images.mjs",
    "images:responsive": "node scripts/generate-responsive-images.mjs",
    "epk:photos": "node scripts/generate-epk-photos.mjs",
    "epk:bundle": "node scripts/generate-epk-bundle.mjs",
    "rider:pdf": "node scripts/generate-tech-rider.mjs",
    "downloads:build": "npm run epk:bundle && npm run rider:pdf && npm run resume:pdf",
    "epk:kit": "npm run epk:photos && npm run downloads:build",
    "prepare": "husky",
    "resume:pdf": "node scripts/generate-resume.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs,cjs}": "eslint --fix",
    "*.scss": "stylelint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeromefaria/jeromefaria.github.io.git"
  },
  "keywords": [],
  "author": "Jerome Faria",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jeromefaria/jeromefaria.github.io/issues"
  },
  "homepage": "https://jeromefaria.com",
  "overrides": {
    "tmp": "^0.2.4",
    "unhead": "^2.1.13"
  },
  "dependencies": {
    "marked": "^18.0.11",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/inter": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.0.16",
    "@vue/test-utils": "^2.5.0",
    "archiver": "^7.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.6.2",
    "exiftool-vendored": "^37.2.0",
    "fontkit": "^2.0.4",
    "happy-dom": "^20.11.15",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^17.4.1",
    "sass": "^1.103.1",
    "sharp": "^0.35.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "subset-font": "^2.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.3.11"
  }
}
