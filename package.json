{
  "name": "jeromefaria-website",
  "version": "1.0.0",
  "description": "Jerome Faria - Sound Artist & Composer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && node scripts/check-anchors.js && vite-ssg build && node scripts/async-css.js",
    "preview": "vite preview",
    "lint": "eslint src scripts e2e playwright.config.ts",
    "lint:fix": "eslint src scripts e2e playwright.config.ts --fix",
    "type-check": "vue-tsc --noEmit",
    "check:anchors": "node scripts/check-anchors.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "npm run build && playwright test --grep-invert @visual",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:visual:update": "playwright test --grep @visual --update-snapshots"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeromefaria/jeromefaria.github.io.git"
  },
  "keywords": [],
  "author": "Jerome Faria",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jeromefaria/jeromefaria.github.io/issues"
  },
  "homepage": "https://jeromefaria.com",
  "overrides": {
    "tmp": "^0.2.4",
    "unhead": "^2.1.13"
  },
  "dependencies": {
    "vue": "^3.5.25",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fontsource/iosevka-aile": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.6.2",
    "fontkit": "^2.0.4",
    "happy-dom": "^20.0.11",
    "jiti": "^2.6.1",
    "sass": "^1.94.2",
    "sharp": "^0.35.0",
    "subset-font": "^2.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.2.1"
  }
}
